#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <4>;
    scroll-layers = <5>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        double_quotation {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <28 29>;
        };

        eq {
            bindings = <&kp EQUAL>;
            key-positions = <24 25>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <15 14>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        mt_to_layer_0: mt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0_MT";
            bindings = <&kp>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp L         &kp U          &kp COMMA               &kp PERIOD                                                              &kp F                  &kp W  &lt 5 R  &kp Y  &kp P
&kp E             &kp I         &kp A          &kp O                   &kp MINUS               &kp TAB                          &kp GRAVE      &kp K                  &kp T  &kp N    &kp S  &kp H
&mt LEFT_SHIFT Z  &kp X         &kp C          &kp V                   &kp SEMICOLON           &lt 3 COLON                      &kp SQT        &kp G                  &kp D  &kp M    &kp J  &mt RIGHT_SHIFT B
&kp LCTRL         &kp LEFT_ALT  &kp LA(SPACE)  &lt_to_layer_0 1 LANG1  &mt LEFT_COMMAND SPACE  &lt_to_layer_0 2 LANGUAGE_2      &kp BACKSPACE  &mt LEFT_SHIFT RETURN                         &kp SLASH
            >;
        };

        NUM_AND_SYMBOLS {
            bindings = <
&kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_NUMBER_4  &kp KP_NUMBER_5                                  &kp KP_NUMBER_6   &kp KP_NUMBER_7    &kp KP_NUMBER_8  &kp KP_NUMBER_9       &kp KP_NUMBER_0
&kp KP_DIVIDE    &kp KP_PLUS      &kp KP_MINUS     &kp KP_ASTERISK  &kp PERCENT      &trans         &kp EXCLAMATION  &kp AT_SIGN       &kp ASTERISK       &kp HASH         &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp DOLLAR       &kp CARET        &kp AMPERSAND    &kp TILDE        &kp PERIOD       &kp EQUAL      &kp QUESTION     &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_BRACE   &kp RIGHT_BRACE       &kp PIPE
&trans           &trans           &trans           &trans           &trans           &trans         &trans           &trans                                                                      &kp BACKSLASH
            >;
        };

        ARROW_AND_FUNCTION {
            bindings = <
&kp ESCAPE  &trans                &kp UP_ARROW          &trans           &trans                          &trans  &trans    &kp UP_ARROW  &trans     &trans
&trans      &kp LEFT_ARROW        &kp DOWN_ARROW        &kp RIGHT_ARROW  &trans  &trans      &trans      &trans  &kp LEFT  &kp DOWN      &kp RIGHT  &trans
&trans      &kp LS(LG(NUMBER_3))  &kp LS(LG(NUMBER_4))  &kp LS(LG(N5))   &trans  &trans      &trans      &trans  &kp F7    &kp F10       &kp F12    &trans
&trans      &trans                &trans                &trans           &trans  &trans      &kp DELETE  &trans                                     &trans
            >;
        };

        BLUETOOTH {
            bindings = <
&trans  &trans        &trans        &trans        &trans                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans      &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans                                                  &bt BT_CLR_ALL
            >;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans    &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &mkp MB5  &mkp MB1  &mkp MB2  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans    &mkp MB4  &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans    &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &mkp MB5  &mkp MB1  &mkp MB2  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans    &mkp MB4  &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                &trans
            >;
        };
    };
};
